# Provider key for the assistant (gpt-4o-mini). The repo-root .env works too.
OPENAI_API_KEY=your-openai-key

# Opik: local self-hosted by default. Traces land in the project named below.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# OPIK_PROJECT_NAME=mastra-banking-agent
# Opik Cloud only: set the key and drop the URL override (workspace = your workspace name).
# OPIK_API_KEY=your-opik-key
