# OpenAI: text-to-speech (to fake the voicemails), Whisper transcription,
# and the gpt-4o-mini triage model.
OPENAI_API_KEY=your-openai-key

# Only needed for Opik Cloud. Local self-hosted Opik needs none of these
# (point the SDK at it with `opik configure --use_local`).
# OPIK_API_KEY=your-opik-key
# OPIK_WORKSPACE=your-workspace-name
