# The workshop assistant runs on gpt-4o-mini
OPENAI_API_KEY=your-openai-key

# Opik: local self-hosted shown here. For Opik Cloud drop OPIK_URL_OVERRIDE and set OPIK_API_KEY.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# OPIK_API_KEY=your-opik-key
# Optional: project to log to (defaults to voltagent-bike-workshop)
# OPIK_PROJECT_NAME=voltagent-bike-workshop
