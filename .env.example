# Copy to .env at the repo root and fill in real values. Every example walks up to this file.
# .env is git-ignored — never commit real keys.

# --- Opik (local self-hosted; usually already in ~/.opik.config) ---
# Run Opik locally: https://www.comet.com/docs/opik/self-host/local_deployment
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# OPIK_API_KEY is not needed for a local Opik. Set it (and change the URL) only to use Opik Cloud.

# --- LLM providers ---
# https://platform.openai.com/api-keys — used by most examples
OPENAI_API_KEY=
# https://console.anthropic.com/settings/keys — used by the Anthropic examples
ANTHROPIC_API_KEY=

# --- Optional ---
# Local Ollama for langchainjs-ollama-garden-rag (default http://localhost:11434)
# OLLAMA_URL=http://localhost:11434
