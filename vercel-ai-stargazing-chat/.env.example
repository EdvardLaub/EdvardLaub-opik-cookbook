# Provider key for the chat model (gpt-4o-mini) and the online judge (stored server-side in Opik)
OPENAI_API_KEY=your-openai-key

# Local self-hosted Opik. No API key needed locally.
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# For Opik Cloud instead: OPIK_URL_OVERRIDE=https://www.comet.com/opik/api and OPIK_API_KEY=your-opik-api-key

# Optional: port for `npm run demo` (default 4220)
# DEMO_PORT=4220
