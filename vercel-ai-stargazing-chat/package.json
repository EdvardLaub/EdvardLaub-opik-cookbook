{
  "name": "vercel-ai-stargazing-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Streaming night-sky observing assistant on the Vercel AI SDK, traced with opik-vercel and scored by a live online rule",
  "scripts": {
    "dev": "next dev -p 4220",
    "build": "next build",
    "ensure-rule": "tsx scripts/ensure-rule.ts",
    "demo": "tsx scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/otel": "^1.0.127",
    "@ai-sdk/react": "^4.0.130",
    "@vercel/otel": "^2.1.3",
    "ai": "^7.0.140",
    "dotenv": "^18.0.7",
    "next": "^16.4.0",
    "opik": "2.2.100",
    "opik-vercel": "2.2.100",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "opik-vercel": {
      "opik": "2.2.100"
    }
