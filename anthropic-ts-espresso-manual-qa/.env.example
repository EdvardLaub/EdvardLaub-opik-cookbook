# Provider key (the model and the judge are both Claude, so one key is enough).
# Alternatively keep it in a parent directory's .env; src/env.ts looks upwards.
ANTHROPIC_API_KEY=

# Opik: local self-hosted instance (set these in your shell or here).
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# Opik Cloud instead: set OPIK_URL_OVERRIDE=https://www.comet.com/opik/api and OPIK_API_KEY=<your key>.
OPIK_PROJECT_NAME=anthropic-ts-espresso-manual-qa
