# Provider key for the changelog writer (and, later, the judge). A parent directory's .env also works.
OPENAI_API_KEY=your-openai-key

# Opik: local self-hosted instance (set these in your shell or here).
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# Opik Cloud instead: OPIK_URL_OVERRIDE=https://www.comet.com/opik/api and OPIK_API_KEY=<your key>.
