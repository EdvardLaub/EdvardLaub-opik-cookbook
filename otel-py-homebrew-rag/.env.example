# The app walks up the directory tree looking for a .env, so a repo-root .env also works.
OPENAI_API_KEY=your-openai-key

# Models (cheap defaults)
BREWFAQ_CHAT_MODEL=gpt-4o-mini
BREWFAQ_EMBED_MODEL=text-embedding-3-small

# Where spans go. These are the defaults, so you only set them for another Opik.
# OPIK_OTLP_ENDPOINT=http://localhost:5173/api/v1/private/otel
# OPIK_WORKSPACE=default
# OPIK_PROJECT_NAME=otel-py-homebrew-rag

# Prompt/completion capture. OFF by default in the instrumentation; the demo runs both ways.
# OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=span_only
