# Copy to .env (or use the repo-root .env). setup.sh reads both.

# Dify stores this as its model-provider credential (the app uses gpt-4o-mini).
OPENAI_API_KEY=your-openai-key

# Optional overrides (defaults shown).
# DIFY_PORT=8090
# DIFY_ADMIN_EMAIL=admin@marigoldlane.example
# DIFY_ADMIN_PASSWORD=MarigoldBoxOffice2026
