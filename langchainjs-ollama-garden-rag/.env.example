# Copy to .env. No model-provider key is needed: Ollama runs locally.
OLLAMA_URL=http://localhost:11434

# Local self-hosted Opik (https://www.comet.com/docs/opik/self-host/local_deployment)
OPIK_URL_OVERRIDE=http://localhost:5173/api/
OPIK_WORKSPACE=default
# Opik Cloud instead: unset OPIK_URL_OVERRIDE and set
# OPIK_API_KEY=your-opik-key
