{
  "name": "langchainjs-ollama-garden-rag",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fully local RAG assistant over a community garden's rulebook, built on LangChain.js and Ollama",
  "scripts": {
    "ask": "tsx src/cli.ts",
    "demo": "tsx src/cli.ts --demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "@langchain/ollama": "^1.3.0",
    "dotenv": "^18.0.7",
    "opik": "2.2.100",
    "opik-langchain": "2.2.100"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "opik-langchain": {
      "opik": "$opik"
    }
  }
}
