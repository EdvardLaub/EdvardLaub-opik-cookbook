# The agent (and the suite's LLM judge) run on OpenAI; gpt-4o-mini is the default model.
OPENAI_API_KEY=your-key-here
# Local Opik at http://localhost:5173 needs nothing else. For Opik Cloud also set:
# OPIK_API_KEY=
# OPIK_WORKSPACE=
# OPIK_OTLP_ENDPOINT=https://www.comet.com/opik/api/v1/private/otel
